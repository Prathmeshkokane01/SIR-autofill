generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id                   String     @id @default(cuid())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  status               String     @default("draft")
  photoData            String?
  voterName            String?
  epicNumber           String?
  dob                  String?
  aadhaarNumber        String?
  mobileNumber         String?
  address              String?
  district             String?
  state                String?
  assemblyConstituency String?
  partNumber           String?
  fatherName           String?
  fatherEpic           String?
  motherName           String?
  motherEpic           String?
  spouseName           String?
  spouseEpic           String?
  paternalGrandfatherName String?
  paternalGrandmotherName String?
  maternalGrandfatherName String?
  maternalGrandmotherName String?
  fieldSource          String?
  documents            Document[]
}

model Document {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  submissionId String
  docType      String
  fileName     String
  mimeType     String?
  fileData     String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
